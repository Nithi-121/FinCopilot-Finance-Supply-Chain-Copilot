# Add a real SEC contact in the form "FinCopilot your.name@example.com" before fetching.
SEC_USER_AGENT=FinCopilot your.email@example.com
TICKERS=HPE,MSFT,AAPL,NVDA,ACN
FILINGS_PER_TICKER=3
# Use a local model (ollama pull qwen2.5:1.5b) or, after `ollama signin`, set OLLAMA_MODEL=gemma4:cloud.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=180
DUCKDB_PATH=
FINCOPILOT_DB_PATH=data/fincopilot.duckdb
FINANCIALS_TABLE=financials
FORECASTS_TABLE=forecasts
ANOMALIES_TABLE=anomalies
CHROMA_PATH=data/index/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=3
